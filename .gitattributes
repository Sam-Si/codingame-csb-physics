# Normalize line endings
* text=auto eol=lf

# C/C++ sources
*.c   text diff=cpp
*.cc  text diff=cpp
*.cpp text diff=cpp
*.h   text diff=cpp
*.hpp text diff=cpp

# Python
*.py text diff=python

# Shell
*.sh text eol=lf

# Battle / data corpus (large JSON; keep as text for diffs)
*.json text
*.md text

# Never treat as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
